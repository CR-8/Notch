# Notch — Environment Variables
# =========================================================
# Notch is BYOK (Bring Your Own Key). All AI provider keys
# are stored in the extension's local storage, NOT in env vars.
# These variables are purely for development tooling.

# --- Optional: Bundle analysis ---
# Set to "true" to generate Vite bundle stats (stats.html)
VITE_BUNDLE_ANALYZE=false

# --- Optional: Log level ---
# One of: debug, info, warn, error, silent (default: info)
VITE_LOG_LEVEL=info

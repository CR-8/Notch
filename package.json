{
  "name": "notch",
  "description": "Capture, structure, and interrogate web content with your own AI key.",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "node --version",
    "dev": "wxt",
    "predev:firefox": "node --version",
    "dev:firefox": "wxt -b firefox",
    "prebuild": "node --version",
    "build": "wxt build",
    "prebuild:firefox": "node --version",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:fix": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "postinstall": "wxt prepare",
    "prepare": "husky",
    "test": "vitest --run"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.19",
    "@mozilla/readability": "^0.6.0",
    "@radix-ui/react-dialog": "^1.1.18",
    "@radix-ui/react-dropdown-menu": "^2.1.19",
    "@radix-ui/react-popover": "^1.1.18",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@radix-ui/react-use-controllable-state": "^1.2.3",
    "@tiptap/core": "^3.27.2",
    "@tiptap/extension-code-block-lowlight": "^3.27.2",
    "@tiptap/extension-highlight": "^3.27.2",
    "@tiptap/extension-horizontal-rule": "^3.27.2",
    "@tiptap/extension-image": "^3.27.2",
    "@tiptap/extension-link": "^3.27.2",
    "@tiptap/extension-list": "^3.27.2",
    "@tiptap/extension-placeholder": "^3.27.2",
    "@tiptap/extension-subscript": "^3.27.2",
    "@tiptap/extension-superscript": "^3.27.2",
    "@tiptap/extension-text-align": "^3.27.2",
    "@tiptap/extension-typography": "^3.27.2",
    "@tiptap/extension-underline": "^3.27.2",
    "@tiptap/extensions": "^3.27.2",
    "@tiptap/pm": "^3.27.2",
    "@tiptap/react": "^3.27.2",
    "@tiptap/starter-kit": "^3.27.2",
    "animejs": "^4.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.4",
    "dompurify": "^3.4.11",
    "fuse.js": "^7.3.0",
    "html2canvas": "^1.4.1",
    "katex": "^0.17.0",
    "lodash.throttle": "^4.1.1",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.23.0",
    "marked": "^18.0.5",
    "mermaid": "^11.14.0",
    "motion": "^12.42.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.6.205",
    "plantuml-encoder": "^1.4.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hotkeys-hook": "^5.3.3",
    "tailwind-merge": "^3.5.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix --quiet",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@base-ui/react": "^1.6.0",
    "@eslint/js": "^10.0.1",
    "@remotion/cli": "^4.0.486",
    "@remotion/renderer": "^4.0.486",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.2",
    "@types/jsdom": "^28.0.1",
    "@types/lodash.throttle": "^4.1.9",
    "@types/mozilla-readability": "^0.2.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.6.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.1",
    "remotion": "^4.0.486",
    "sass": "^1.101.0",
    "sass-embedded": "^1.100.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.4",
    "wxt": "^0.20.20"
  }
}
